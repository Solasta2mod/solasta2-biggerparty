# game data extracted from the paks / disassembly listings — regenerate locally with the tools, never publish
extracted-config/
tools/*.asm

# generated installer payload (contains UE4SS binaries) and build outputs
BiggerParty/installer/payload/
BiggerParty/installer/payload.rc
BiggerParty/installer/payload_index.h
BiggerParty/installer/build/
BiggerParty/build/

# binaries are published as GitHub Release assets, not committed
BiggerParty/dist/BiggerParty-Installer.exe
BiggerParty/dist/version.dll
BiggerParty/dist/*.zip
*.obj
*.res
*.exp
*.lib
*.pdb

__pycache__/
*.pyc

# private working notes, kept outside the repo
docs-workspace-notes.md
# local build inputs (the UE4SS release the installer embeds), kept out of the repository
BiggerParty/private/

# game text pulled from the paks for the narration pack, and the rendered audio: never in the repository
# (the recordings ship inside the release's installer)
Narrator/text/
Narrator/pack/
Narrator/companion/dist/
Narrator/companion/build/
